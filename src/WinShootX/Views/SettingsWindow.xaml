<Window x:Class="WinShootX.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinShootX.Views.Controls"
        Title="Cài đặt — Win ShootX" Height="580" Width="480"
        WindowStartupLocation="CenterScreen" Background="#1E1F24"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Phím tắt" Foreground="White" FontWeight="Bold" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chụp vùng chọn" Foreground="#CCCCCC" VerticalAlignment="Center" />
            <TextBox x:Name="RegionHotkeyBox" Grid.Column="1" Margin="0,4" />
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chụp toàn màn hình" Foreground="#CCCCCC" VerticalAlignment="Center" />
            <TextBox x:Name="FullScreenHotkeyBox" Grid.Column="1" Margin="0,4" />
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chụp cửa sổ đang chọn" Foreground="#CCCCCC" VerticalAlignment="Center" />
            <TextBox x:Name="WindowHotkeyBox" Grid.Column="1" Margin="0,4" />
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chụp cuộn trang" Foreground="#CCCCCC" VerticalAlignment="Center" />
            <TextBox x:Name="ScrollHotkeyBox" Grid.Column="1" Margin="0,4" />
        </Grid>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quay màn hình" Foreground="#CCCCCC" VerticalAlignment="Center" />
            <TextBox x:Name="RecordHotkeyBox" Grid.Column="1" Margin="0,4" />
        </Grid>

        <TextBlock Text="Lưu trữ" Foreground="White" FontWeight="Bold" Margin="0,8,0,8" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SaveDirBox" IsReadOnly="True" />
            <c:IconButton Grid.Column="1" IconData="{StaticResource IconFolder}" IconSize="14" Content="Chọn thư mục"
                          Click="OnBrowseClick" Style="{StaticResource GhostIconButton}" Margin="6,0,0,0" Padding="8,4" />
        </Grid>

        <CheckBox x:Name="CopyAfterCaptureCheck" Content="Tự động copy vào clipboard sau khi chụp" Foreground="White" Margin="0,4" />
        <CheckBox x:Name="OpenAnnotatorCheck" Content="Tự động mở trình chú thích sau khi chụp" Foreground="White" Margin="0,4" />
        <CheckBox x:Name="LaunchAtStartupCheck" Content="Khởi động cùng Windows" Foreground="White" Margin="0,4" />
        <CheckBox x:Name="ShutterSoundCheck" Content="Phát âm thanh khi chụp" Foreground="White" Margin="0,4" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <c:IconButton IconData="{StaticResource IconClose}" IconSize="14" Content="Huỷ" Click="OnCancelClick" Style="{StaticResource GhostIconButton}" />
            <c:IconButton IconData="{StaticResource IconSave}" IconSize="14" Content="Lưu" Click="OnSaveClick" Style="{StaticResource PrimaryIconButton}" />
        </StackPanel>
    </StackPanel>
</Window>
