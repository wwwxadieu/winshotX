<Window x:Class="WinShootX.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử chụp — Win ShootX" Height="480" Width="360"
        WindowStartupLocation="CenterScreen" Background="#1E1F24">
    <Grid>
        <TextBlock Text="Chưa có ảnh nào được chụp trong phiên này."
                   Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding EmptyHintVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
        <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="6" Background="#FF14151A" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Image}" Width="64" Height="40" Stretch="Uniform" />
                            <TextBlock Text="{Binding CapturedAtUtc, StringFormat='HH:mm:ss'}"
                                       Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
