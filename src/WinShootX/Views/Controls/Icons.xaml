<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bộ icon vector dùng chung cho toàn bộ ứng dụng — QUY TẮC THIẾT KẾ: không dùng emoji hay ký tự
        Unicode (✏️ 📌 ↗ ✕ ...) làm icon ở bất kỳ đâu trong app (nút bấm, menu, tray, dialog), kể cả
        khi thêm tính năng mới sau này. Mọi icon mới phải được thêm vào đây dưới dạng Geometry và dùng
        qua IconButton/IconToggleButton (xem IconControls.xaml) — không viết Path/hardcode rải rác.

        Toạ độ vẽ trên lưới 24x24, phong cách line-icon (nét đơn, bo góc) để hiển thị nhất quán khi
        render với Stroke = màu chữ hiện tại (xem IconControls.xaml) và Fill = Transparent trong đa số
        trường hợp. Đây là geometry tự vẽ đơn giản (không lấy từ bộ icon có bản quyền nào) — có thể
        thay bằng bộ icon chuyên nghiệp hơn (vd Fluent System Icons) sau này miễn giữ đúng key.
    -->

    <PathGeometry x:Key="IconArrow" Figures="M5,19 L17,7 M10,7 L17,7 L17,14" />

    <RectangleGeometry x:Key="IconRectangle" Rect="4,6,16,12" RadiusX="1.5" RadiusY="1.5" />

    <EllipseGeometry x:Key="IconEllipse" Center="12,12" RadiusX="8" RadiusY="6" />

    <PathGeometry x:Key="IconPencil" Figures="M4,20 L8,20 L20,8 L16,4 L4,16 Z" />

    <PathGeometry x:Key="IconTextTool" Figures="M5,6 L19,6 M12,6 L12,19" />

    <PathGeometry x:Key="IconHighlighter" Figures="M6,18 L16,8 L19,11 L9,21 L6,21 Z M15,7 L18,4 L21,7 L18,10 Z" />

    <PathGeometry x:Key="IconBlur"
                  Figures="M4,4 L11,4 L11,11 L4,11 Z M13,4 L20,4 L20,11 L13,11 Z M4,13 L11,13 L11,20 L4,20 Z M13,13 L20,13 L20,20 L13,20 Z" />

    <EllipseGeometry x:Key="IconStepNumber" Center="12,12" RadiusX="7.5" RadiusY="7.5" />

    <PathGeometry x:Key="IconCrop"
                  Figures="M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M4,16 L4,20 L8,20 M20,16 L20,20 L16,20" />

    <GeometryGroup x:Key="IconPin">
        <EllipseGeometry Center="12,8" RadiusX="4" RadiusY="4" />
        <PathGeometry Figures="M12,12 L12,21 M8.5,21 L15.5,21" />
    </GeometryGroup>

    <PathGeometry x:Key="IconOcr"
                  Figures="M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M4,16 L4,20 L8,20 M20,16 L20,20 L16,20 M8,10 L16,10 M8,14 L14,14" />

    <PathGeometry x:Key="IconSave"
                  Figures="M4,4 L16,4 L20,8 L20,20 L4,20 Z M7,4 L7,10 L15,10 L15,4 M7,14 L17,14 L17,20 L7,20 Z" />

    <PathGeometry x:Key="IconCopy" Figures="M4,4 L16,4 L16,16 L4,16 Z M8,8 L20,8 L20,20 L8,20 Z" />

    <PathGeometry x:Key="IconShare" Figures="M4,14 L4,20 L20,20 L20,14 M12,16 L12,3 M7,8 L12,3 L17,8" />

    <PathGeometry x:Key="IconClose" Figures="M5,5 L19,19 M19,5 L5,19" />

    <PathGeometry x:Key="IconUndo" Figures="M7,10 A7,7 0 1 1 6,15 M3,8 L7,10 L7,5" />

    <PathGeometry x:Key="IconRedo" Figures="M17,10 A7,7 0 1 0 18,15 M21,8 L17,10 L17,5" />

    <GeometryGroup x:Key="IconSettings">
        <EllipseGeometry Center="12,12" RadiusX="6.5" RadiusY="6.5" />
        <EllipseGeometry Center="12,12" RadiusX="2.2" RadiusY="2.2" />
        <PathGeometry Figures="M12,2.5 L12,5 M12,19 L12,21.5 M2.5,12 L5,12 M19,12 L21.5,12" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconHistory">
        <EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" />
        <PathGeometry Figures="M12,7 L12,12 L16,14.5" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconCamera">
        <PathGeometry Figures="M3,8 L8,8 L9,5 L15,5 L16,8 L21,8 L21,19 L3,19 Z" />
        <EllipseGeometry Center="12,14" RadiusX="3.3" RadiusY="3.3" />
    </GeometryGroup>

    <PathGeometry x:Key="IconWindowCapture" Figures="M4,5 L20,5 L20,19 L4,19 Z M4,9 L20,9" />

    <PathGeometry x:Key="IconFullScreen" Figures="M4,5 L20,5 L20,15 L4,15 Z M9,19 L15,19 M12,15 L12,19" />

    <PathGeometry x:Key="IconFolder" Figures="M3,7 L9,7 L11,5 L21,5 L21,19 L3,19 Z" />

    <PathGeometry x:Key="IconExit" Figures="M12,3 L12,11 M6.2,6.2 A8,8 0 1 0 17.8,6.2" />

    <PathGeometry x:Key="IconUpdate" Figures="M4,12 A8,8 0 1 1 6.3,17.5 M4,12 L4,18 M4,12 L10,12" />

    <PathGeometry x:Key="IconScroll"
                  Figures="M6,3 L18,3 L18,21 L6,21 Z M9,9 L12,12.5 L15,9 M9,14.5 L12,18 L15,14.5" />

    <EllipseGeometry x:Key="IconRecord" Center="12,12" RadiusX="7" RadiusY="7" />

    <RectangleGeometry x:Key="IconStop" Rect="6,6,12,12" RadiusX="1.5" RadiusY="1.5" />

</ResourceDictionary>
