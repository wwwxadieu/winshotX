<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WinShootX.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Style mặc định (implicit, không x:Key) cho IconButton/IconToggleButton — áp dụng tự động cho
        MỌI nơi dùng 2 control này trong toàn app, trừ khi override bằng Style x:Key khác (xem
        ToolbarIconToggle, PrimaryIconButton, GhostIconButton bên dưới). Đây là style "trong suốt,
        hover sáng nhẹ" dùng cho các thanh công cụ nền tối (CaptureBarWindow, toolbar trên của
        AnnotationEditorWindow).
    -->
    <Style TargetType="{x:Type c:IconButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:IconButton}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Icon" Data="{TemplateBinding IconData}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform"
                                  Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- Nút chỉ icon (không đặt Content): bỏ khoảng đệm phải của icon vốn dành
                             chỗ cho chữ, để icon nằm giữa padding thay vì lệch trái. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cùng layout/hover như IconButton, cộng thêm trạng thái IsChecked = nền xanh accent — dùng cho
         nhóm công cụ chọn 1-trong-N (toolbar trên của AnnotationEditorWindow). -->
    <Style TargetType="{x:Type c:IconToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:IconToggleButton}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Icon" Data="{TemplateBinding IconData}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform"
                                  Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FF3B82F6" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Biến thể nút hành động chính (nền xanh đặc) — dùng cho Lưu/Copy ở toolbar dưới của AnnotationEditorWindow. -->
    <Style x:Key="PrimaryIconButton" TargetType="{x:Type c:IconButton}" BasedOn="{StaticResource {x:Type c:IconButton}}">
        <Setter Property="Background" Value="#FF2563EB" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Biến thể nút hành động phụ (viền mỏng, không nền) — dùng cho Undo/Redo/Đóng/Huỷ. -->
    <Style x:Key="GhostIconButton" TargetType="{x:Type c:IconButton}" BasedOn="{StaticResource {x:Type c:IconButton}}">
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

</ResourceDictionary>
