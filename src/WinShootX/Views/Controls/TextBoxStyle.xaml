<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Style mặc định (implicit, không x:Key) cho TextBox — áp dụng tự động cho MỌI TextBox trong
        toàn ứng dụng (Settings, và bất kỳ form nào thêm sau này) trừ khi bị ghi đè bởi thuộc tính đặt
        trực tiếp trên từng control. Bo góc mềm mại (CornerRadius) + viền tinh tế đổi màu khi hover/focus
        thay cho khung chữ nhật sắc cạnh mặc định của Windows — đồng bộ với phong cách "mềm mại, clean"
        đã dùng cho IconButton (CornerRadius) trong IconControls.xaml.

        Lưu ý: TextBox dùng làm công cụ "Chữ" trong AnnotationEditorWindow (vẽ text lên ảnh) tự đặt
        Padding/BorderThickness/Background riêng để giữ vị trí gõ chữ sát điểm click, không bị ảnh
        hưởng bởi padding mặc định ở đây — xem AddTextBox trong AnnotationEditorWindow.xaml.cs.
    -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FF2A2B32" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="#553B82F6" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3B82F6" />
                            <Setter TargetName="Bg" Property="Background" Value="#FF31323B" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FF25262C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
