<Window x:Class="WinShootX.Views.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinShootX.Views.Controls"
        Title="Win ShootX — Chú thích" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F24">
    <DockPanel>
        <!-- Một thanh công cụ duy nhất trên cùng: công cụ vẽ + màu bên trái, hành động (Undo/Redo/
             Sao chép/Lưu/Đóng) bên phải. Toàn bộ nút chỉ hiện icon (ToolTip thay cho nhãn chữ) —
             gọn hơn và nhất quán với thanh công cụ nổi CaptureBarWindow. -->
        <DockPanel DockPanel.Dock="Top" Background="#FF14151A" Height="52" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <c:IconToggleButton x:Name="ToolArrow" IconData="{StaticResource IconArrow}" ToolTip="Mũi tên" Checked="OnToolChecked" Tag="Arrow" />
                <c:IconToggleButton x:Name="ToolRect" IconData="{StaticResource IconRectangle}" ToolTip="Chữ nhật" Checked="OnToolChecked" Tag="Rectangle" />
                <c:IconToggleButton x:Name="ToolEllipse" IconData="{StaticResource IconEllipse}" ToolTip="Oval" Checked="OnToolChecked" Tag="Ellipse" />
                <c:IconToggleButton x:Name="ToolFreehand" IconData="{StaticResource IconPencil}" ToolTip="Bút vẽ" Checked="OnToolChecked" Tag="Freehand" />
                <c:IconToggleButton x:Name="ToolText" IconData="{StaticResource IconTextTool}" ToolTip="Chữ" Checked="OnToolChecked" Tag="Text" />
                <c:IconToggleButton x:Name="ToolHighlight" IconData="{StaticResource IconHighlighter}" ToolTip="Highlight" Checked="OnToolChecked" Tag="Highlight" />
                <c:IconToggleButton x:Name="ToolBlur" IconData="{StaticResource IconBlur}" ToolTip="Làm mờ" Checked="OnToolChecked" Tag="Blur" />
                <c:IconToggleButton x:Name="ToolStep" IconData="{StaticResource IconStepNumber}" ToolTip="Số bước" Checked="OnToolChecked" Tag="StepNumber" />
                <c:IconToggleButton x:Name="ToolCrop" IconData="{StaticResource IconCrop}" ToolTip="Crop" Checked="OnToolChecked" Tag="Crop" />

                <Rectangle Width="1" Fill="#33FFFFFF" Margin="8,10" />

                <ItemsControl x:Name="ColorSwatches" ItemsSource="{Binding SwatchColors, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="20" Height="20" CornerRadius="10" Margin="3" Background="{Binding}"
                                    MouseLeftButtonDown="OnSwatchClick" Cursor="Hand" BorderBrush="White" BorderThickness="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <c:IconButton IconData="{StaticResource IconUndo}" ToolTip="Undo" Click="OnUndoClick" Style="{StaticResource GhostIconButton}" />
                <c:IconButton IconData="{StaticResource IconRedo}" ToolTip="Redo" Click="OnRedoClick" Style="{StaticResource GhostIconButton}" />
                <c:IconButton IconData="{StaticResource IconCopy}" ToolTip="Sao chép" Click="OnCopyClick" Style="{StaticResource PrimaryIconButton}" />
                <c:IconButton IconData="{StaticResource IconSave}" ToolTip="Lưu" Click="OnSaveClick" Style="{StaticResource PrimaryIconButton}" />
                <c:IconButton IconData="{StaticResource IconClose}" ToolTip="Đóng" Click="OnCloseClick" Style="{StaticResource GhostIconButton}" Margin="4,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Background="#FF0F1013">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="BaseImage" Stretch="None" />
                    <Canvas x:Name="AnnotationCanvas" Background="Transparent"
                            MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp" />
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
