<Window x:Class="WinShootX.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Lớp phủ tối mờ toàn màn hình; vùng đang chọn sẽ được "khoét sáng" bằng cách vẽ đè ảnh nền gốc (xem code-behind). -->
        <Canvas x:Name="RootCanvas" Background="#59000000">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#FF3B82F6" StrokeThickness="1.5"
                       Fill="Transparent"
                       Visibility="Collapsed" />
            <Border x:Name="SizeLabel"
                    Background="#CC1F2937" CornerRadius="4" Padding="6,2"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeLabelText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
    </Grid>
</Window>
