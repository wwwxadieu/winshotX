<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 mở khóa WinRT API (Windows.Media.Ocr, Windows.Graphics.Capture) dùng ở Giai đoạn 3-4 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinShootX</AssemblyName>
    <RootNamespace>WinShootX</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <!-- Version được publish truyền qua -p:Version=X.Y.Z (xem release.yml) — SDK tự sinh
         AssemblyVersion/AssemblyFileVersion từ giá trị này, đọc lại lúc runtime trong
         Services/AppUpdateService.cs để biết bản đang chạy khi so sánh với GitHub Releases mới nhất.
         Build cục bộ không truyền -p:Version thì dùng mặc định dưới đây. -->
    <Version Condition="'$(Version)' == ''">0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Không cần PackageReference riêng cho WinRT interop: từ .NET 5 trở đi, khi TargetFramework có
      hậu tố windows10.0.xxxxx.0 (như trên), SDK tự sinh projection cho namespace Windows.* (bao gồm
      Windows.Media.Ocr dùng ở OcrService.cs, Windows.Graphics.Capture dùng ở Giai đoạn 3) — không cần
      thêm gói Microsoft.Windows.CsWinRT thủ công.
    -->
    <!-- Icon tray -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

</Project>
